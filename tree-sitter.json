{
  "grammars": [
    {
      "name": "mcfunction",
      "camelcase": "Mcfunction",
      "scope": "source.mcfunction",
      "path": "src",
      "file-types": ["mcfunction"],
      "highlights": "src/queries/highlights.scm",
      "injection-regex": "^mcfunction$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Minecraft mcfunction files",
    "authors": [],
    "links": {
      "repository": "https://github.com/user/tree-sitter-mcfunction"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false
  }
}
